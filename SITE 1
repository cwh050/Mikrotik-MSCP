/interface list
add name=WAN
add name=LAN
/ip hotspot profile
set [ find default=yes ] html-directory=hotspot
/ip pool
add name=default-dhcp ranges=192.168.1.200-192.168.1.254
/ip dhcp-server
add address-pool=default-dhcp interface=bridge name=defconf
/interface bridge port
add bridge=bridge interface=ether2
add bridge=bridge interface=ether3
add bridge=bridge interface=ether4
add bridge=bridge interface=ether5
/ip neighbor discovery-settings
set discover-interface-list=LAN
/interface list member
add interface=bridge list=LAN
add interface=ether1 list=WAN
/ip address
add address=192.168.1.1/24 interface=bridge network=192.168.1.0
add address=10.0.0.1/24 interface=ether1 network=10.0.0.0
/ip dhcp-server network
add address=192.168.1.0/24 dns-server=192.168.1.1 gateway=192.168.1.1
/ip dns
set allow-remote-requests=yes
/ip dns static
add address=192.168.1.1 name=router.local
/ip firewall filter
add action=accept chain=input connection-state=established,related,untracked
add action=drop chain=input connection-state=invalid
add action=accept chain=input protocol=icmp
add action=accept chain=input dst-address=127.0.0.1
add action=drop chain=input in-interface-list=!LAN
add action=accept chain=forward ipsec-policy=in,ipsec
add action=accept chain=forward ipsec-policy=out,ipsec
add action=fasttrack-connection chain=forward connection-state=\
    established,related hw-offload=yes
add action=accept chain=forward connection-state=\
    established,related,untracked
add action=drop chain=forward connection-state=invalid
add action=drop chain=forward connection-nat-state=!dstnat connection-state=\
    new in-interface-list=WAN
/ip firewall nat
add action=masquerade chain=srcnat ipsec-policy=out,none out-interface-list=\
    WAN
add action=dst-nat chain=dstnat comment="Master Repeater" dst-port=50000 \
    in-interface=ether1 protocol=udp to-addresses=192.168.1.2 to-ports=50000
add action=dst-nat chain=dstnat comment="Peer Repeater 1" dst-port=50001 \
    in-interface=ether1 protocol=udp to-addresses=192.168.1.3 to-ports=50001
add action=dst-nat chain=dstnat comment="Peer Repeater 2" dst-port=50002 \
    in-interface=ether1 protocol=udp to-addresses=192.168.1.4 to-ports=50002
add action=dst-nat chain=dstnat comment="Rest Channel Host" dst-port=55000 \
    in-interface=ether1 protocol=udp to-addresses=192.168.1.100 to-ports=\
    55000
add action=dst-nat chain=dstnat comment="IP Remote Programming" dst-port=\
    50000-50100 in-interface=ether1 protocol=tcp to-addresses=192.168.1.0/24
/ipv6 settings
    disable-ipv6
/system note
set show-at-login=no
/tool mac-server
set allowed-interface-list=LAN
/tool mac-server mac-winbox
set allowed-interface-list=LAN
/certificate
add name="ca-template" common-name="Mikrotik-CA" key-size=2048 days-valid=3650
sign ca-template ca=ca-template comment="Create a Certificate Authority"
add name="server-template" common-name="ovpn-server" key-size=2048 days-valid=3650 comment="Create the Server Certificates"
sign server-template ca=ca-template server=yes
add name="client-router2-template" common-name="ovpn-client" key-size=2048 days-valid=3650
sign client-router2-template ca=ca-template client=yes
/certificate export-certificate ca=ca-template passphrase="" file-name=ca_cert.crt
/certificate export-certificate client=client-router2-template passphrase="" file-name=client_cert.crt
/certificate export-certificate client=client-router2-template passphrase="" file-name=client_key.key
/interface ovpn-server
set enabled=yes auth=sha1 cipher=aes128 name="ovpn-server"
set port=1194
set certificate=server-template
/ip pool
add name=ovpn_pool ranges=10.0.0.1-10.0.0.254
/ip address
add address=10.0.0.1/24 interface=ovpn-server-interface
/ppp profile
add name=ovpn-profile remote-address=ovpn_pool local-address=10.0.0.1
/ppp secret
add name=ovpn-client-router2 password="" profile=ovpn-profile service=ovpn
/ip firewall filter
add chain=input action=accept protocol=tcp dst-port=1194 comment="Allow OpenVPN traffic"
/ip route
add dst-address=172.6.1.0/24 gateway=10.0.0.2 comment="Route to Client Router's network"
/ip firewall filter
add chain=forward action=accept src-address=10.0.0.2 dst-address=10.0.0.0/24 comment="Allow OVPN traffic to local LAN"
